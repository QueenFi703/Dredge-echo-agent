# Create an API key in Nebius Token Factory and keep the real value out of git.
NEBIUS_API_KEY=replace-with-your-token-factory-key

# Copy the exact model identifier shown in the Token Factory model catalog.
NEBIUS_MODEL=replace-with-a-token-factory-model-id

# Dedicated evidence critic. Do not set this to the Kimi synthesis variable.
NVIDIA_MODEL=replace-with-a-nemotron-token-factory-model-id

# Optional. Override only for a compatible proxy or dedicated endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Tavily powers Dredge Echo's live retrieval layer. Keep the real key out of git.
TAVILY_API_KEY=replace-with-your-tavily-key

# Optional project label for Tavily usage tracking.
TAVILY_PROJECT=dredge-echo-agent
